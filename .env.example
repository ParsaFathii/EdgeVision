# EdgeVision — قالب متغیرهای محیطی
# این فایل را به نام «.env» در ریشهٔ مخزن کپی کنید و در صورت نیاز مقدارها را تغییر دهید.
# همهٔ دستورها (bun run dev، bun run db:push) از ریشهٔ مخزن اجرا می‌شوند و
# مسیر نسبی SQLite نسبت به همان ریشه resolve می‌شود.
# سرویس موتور (mini-services/engine-service) این فایل را نمی‌خواند و مسیر
# دیتابیس را نسبت به محل خودش (همان db/custom.db) پیدا می‌کند — پس هر دو سرویس
# همیشه روی یک فایل دیتابیس کار می‌کنند.
DATABASE_URL=file:db/custom.db
